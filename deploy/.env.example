# Deploy identity. Compose derives isolated resource names from DEPLOY_ENV.
DEPLOY_ENV=staging

# Immutable OCI image references. Do not use a mutable `latest` tag.
APP_IMAGE=ghcr.io/OWNER/REPOSITORY/app:COMMIT_SHA
MIGRATION_IMAGE=ghcr.io/OWNER/REPOSITORY/migrator:COMMIT_SHA

# Public canonical URL. It is also a build argument when creating APP_IMAGE.
NEXT_PUBLIC_APP_URL=https://staging.lunabiner.com
APP_HOST=staging.lunabiner.com
TRAEFIK_ROUTER_NAME=lunabiner-staging
TRAEFIK_SERVICE_NAME=lunabiner-staging

# Production only: used together with compose.production.yml.
REDIRECT_FROM_HOST=lunabiner.tech
TRAEFIK_REDIRECT_ROUTER_NAME=lunabiner-production-redirect
TRAEFIK_REDIRECT_MIDDLEWARE_NAME=lunabiner-production-redirect

# PostgreSQL is internal to this Compose project. URL-encode reserved password
# characters in DATABASE_URL; POSTGRES_PASSWORD itself remains the raw password.
POSTGRES_DB=lunabiner_staging
POSTGRES_USER=lunabiner_staging
POSTGRES_PASSWORD=replace-with-a-unique-secret
DATABASE_URL=postgresql://lunabiner_staging:replace-with-url-encoded-secret@db:5432/lunabiner_staging?schema=public

# Leave false/empty unless the AI assistant is intentionally configured.
AI_ASSISTANT_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
