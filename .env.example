# PostgreSQL connection string. Do not expose this value to the browser.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_boilerplate?schema=public"

# Public application identity and canonical origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional server-only absolute persistent directory; default storage/portfolio-covers.
# Keep this volume outside deployment build artifacts and back it up with the DB.
PORTFOLIO_UPLOAD_DIR=""
# Optional server-only absolute persistent directory; default storage/product-covers.
PRODUCT_UPLOAD_DIR=""

# Server-only AI provider configuration. Supply real values only in .env/secret manager.
AI_ASSISTANT_ENABLED="false"
LLM_PROVIDER="openai-compatible"
LLM_BASE_URL="https://api.openai.com/v1/chat/completions"
LLM_API_KEY=""
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""

# Use production when deployed. Secure session cookies are enabled outside development.
NODE_ENV="development"
