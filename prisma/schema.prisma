generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CONTENT_EDITOR
  MARKETING
  SALES
  MEMBER
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AiConversationStatus {
  ACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ContentKind {
  ARTICLE
  CASE_STUDY
  PRODUCT
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  projects     Project[] @relation("ProjectOwner")
  auditEvents  AuditEvent[]
  contentEntries ContentEntry[]
  assignedLeads Lead[] @relation("LeadOwner")
  leadNotes LeadNote[]
  leadActivities LeadActivity[]
}

model ContentEntry {
  id          String @id @default(uuid()) @db.Uuid
  kind        ContentKind
  slug        String
  status      ContentStatus @default(DRAFT)
  translations Json
  details     Json
  authorId    String?
  author      User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  version     Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  module    String
  recordId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())
  @@index([module, recordId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  @@index([ownerId])
}

model AiConfiguration {
  id                  String   @id @default(uuid()) @db.Uuid
  activeModel         String   @default("gpt-4o-mini")
  temperature         Float    @default(0.2)
  maxOutputTokens     Int      @default(500)
  contextMessageLimit Int      @default(8)
  ragEnabled          Boolean  @default(true)
  systemPrompt        String?
  settings            Json?
  updatedBy           String?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model AiConversation {
  id        String               @id @default(uuid()) @db.Uuid
  sessionId String               @db.Uuid
  language  String               @default("id")
  title     String?
  summary   String?
  summaryMessageCount Int @default(0)
  userId    String?
  busyUntil DateTime?
  status    AiConversationStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  messages  AiMessage[]
  @@index([sessionId, updatedAt])
}

model AiMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Lead {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  company        String?
  email          String
  phone          String?
  serviceInterest String?
  challenge      String
  source         String
  language       String     @default("id")
  status         LeadStatus @default(NEW)
  score          Int        @default(0)
  budget         String?
  timeline       String?
  sourcePage     String?
  ownerId        String?
  owner          User? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  version        Int @default(1)
  notes          LeadNote[]
  activities     LeadActivity[]
  conversationId String?    @db.Uuid
  consentAt      DateTime @default(now())
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@index([status, createdAt])
  @@index([ownerId, status])
}

model LeadNote {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body String
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model LeadActivity {
  id String @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action String
  details Json?
  createdAt DateTime @default(now())
  @@index([leadId, createdAt])
}

model AiKnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid
  sourceKey String @unique
  source String
  title String
  href String
  content String
  embedding Json
  embeddingModel String
  contentHash String
  updatedAt DateTime @updatedAt
}

model AiRateBucket {
  id String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model AiAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String?
  action String
  createdAt DateTime @default(now())
}
